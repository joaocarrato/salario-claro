{
  "expo": {
    "name": "Salário Claro",
    "slug": "salario-claro",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/adaptive-icon.png",
    "scheme": "salarioclaro",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "icon": {
        "light": "./assets/images/ios-light.png",
        "dark": "./assets/images/ios-dark.png",
        "tinted": "./assets/images/ios-tinted.png"
      },
      "bundleIdentifier": "com.anonymous.salarioclaro"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.salarioclaro"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0C63DF",
          "dark": {
            "backgroundColor": "#0C63DF"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Roboto",
                "fontDefinitions": [
                  {
                    "path": "./src/assets/fonts/Roboto-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./src/assets/fonts/Roboto-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./src/assets/fonts/Roboto-Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "Playfair Display",
                "fontDefinitions": [
                  {
                    "path": "./src/assets/fonts/PlayfairDisplay-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "./src/assets/fonts/PlayfairDisplay-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "./src/assets/fonts/PlayfairDisplay-Bold.ttf",
                    "weight": 700
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./src/assets/fonts/Roboto-Regular.ttf",
              "./src/assets/fonts/Roboto-Medium.ttf",
              "./src/assets/fonts/Roboto-Bold.ttf",
              "./src/assets/fonts/PlayfairDisplay-Regular.ttf",
              "./src/assets/fonts/PlayfairDisplay-Medium.ttf",
              "./src/assets/fonts/PlayfairDisplay-Bold.ttf"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "909961c9-e704-4224-aabe-9649fd755c90"
      }
    }
  }
}
